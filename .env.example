# 复制为 .env 后只在本机填写；不要把 .env 提交、上传或发送到聊天。
COPPER_MAS_LIVE_CALLS=false

# Kimi K3 中国站；URL、模型与预算默认值保存在 configs/llm/providers.yaml。
KIMI_API_KEY=

# 旧版解释与新的 V4 Flash 诊断共用此键。
# 诊断助手也可从工作区根 .env 只读取这一项；无需复制密钥。
# 诊断模型与预算：configs/llm/diagnostic_agent.yaml。
DEEPSEEK_API_KEY=

# G1 本地资源：通过进程环境设置；留空时使用现有默认路径。
COPPER_MVP_DATA_DIR=
COPPER_MVP_CONTRACT_DIR=
COPPER_MVP_LABEL_DIR=
COPPER_MVP_EVIDENCE_DIR=
COPPER_MVP_G1_ENABLED=true

# G2a 比较接口开关，通过进程环境配置。
COPPER_MVP_G2A_ENABLED=true

# G3 自由问答：通过进程环境明确启用真实调用。
COPPER_ASSISTANT_LIVE_CALLS=0
